# Supabase project settings -> Database -> Connection string -> URI
# Use the pooled ("Transaction" mode, port 6543) connection string for the
# app itself, since serverless/edge functions should not hold long-lived
# direct connections. See docs/database.md for details.
DATABASE_URL="postgresql://postgres.acqgooqyhwpvprecjtwl:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres"

# Admin dashboard (app/admin) — edits the tables above without redeploying.
# See docs/admin-dashboard.md.
ADMIN_PASSWORD="change-me"
# Random string used to sign the admin session cookie, e.g. the output of:
#   openssl rand -base64 32
ADMIN_SESSION_SECRET="change-me"

# Supabase project settings -> API. Used server-side only, to upload blog
# post images (cover + inline) to Supabase Storage from the admin. The
# secret key bypasses Storage's Row Level Security, so never expose it to
# the client.
SUPABASE_URL="https://acqgooqyhwpvprecjtwl.supabase.co"
SUPABASE_SECRET_KEY="change-me"